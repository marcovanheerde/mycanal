# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# Roboflow private API key (Settings > API Keys in your workspace)
ROBOFLOW_API_KEY=

# project-slug/version for the trained boat model (workspace is inferred from the API key)
ROBOFLOW_MODEL_ID=amsterdam-boat-spotting-v2/1

# RTSP URL for the Reolink E1 Outdoor, e.g.:
# rtsp://<username>:<password>@<camera-ip>:554/h264Preview_01_main
RTSP_URL=

# Minimum detection confidence (0-1)
CONFIDENCE_THRESHOLD=0.5

# Optional: override the counting line as x1,y1,x2,y2 in pixel coords
# of the incoming frame. If unset, defaults to a vertical line down
# the middle of the frame.
# LINE_COORDS=960,0,960,1080

# Publish a downscaled snapshot + counts to data/ and git push, for the
# GitHub Pages site to display. Requires the repo's git remote to already
# be set up with push access (see README/setup notes).
PUBLISH_ENABLED=false

# How often to publish, in seconds. Every publish is a git commit + push,
# so shorter intervals mean faster repo growth (images add up over weeks
# of continuous running) - 300s (5 min) is a reasonable default.
PUBLISH_INTERVAL_SECONDS=300
